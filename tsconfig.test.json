{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@devguard/core": ["./packages/core/src/index.ts"],
      "@devguard/validator": ["./packages/validator/src/index.ts"],
      "@devguard/scanner": ["./packages/scanner/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "tests", "vitest.config.ts", "examples/typescript"]
}
